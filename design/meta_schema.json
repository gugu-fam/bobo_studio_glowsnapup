                "methods": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {"type": "string"},
                      "args": {"type": "array"},
                      "return": {"type": "string"},
                      "exceptions": {"type": "array"},
                      "responsibilities": {"type": "string"}
